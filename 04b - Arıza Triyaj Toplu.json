        "jsCode": "// Orijinal kaydı (bölge, açıklama) sonuca geri ekle\nreturn $input.all().map((i, idx) => ({\n  json: {\n    ...i.json,\n    body: $('Loop Over Items').itemMatching(idx).json.body,\n    bilet_no: 'TT-' + Date.now().toString().slice(-6) + idx\n  }\n}));"
