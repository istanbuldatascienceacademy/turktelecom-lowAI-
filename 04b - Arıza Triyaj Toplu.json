        "options": {
          "temperature": 0
        }
      },
      "id": "0a54f9f5-d98b-4ac4-940a-3faaa48a841d",
      "name": "Gemini (Triyaj)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        200,
        220
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"oncelik\": \"P2\",\n  \"etkilenen_hizmet\": \"Fiber internet\",\n  \"ilk_aksiyon\": \"Modem uzaktan yeniden başlatılsın, sonuç alınmazsa saha ekibi\",\n  \"ozet\": \"Müşterinin fiber bağlantısı dünden beri kesik.\"\n}"
      },
