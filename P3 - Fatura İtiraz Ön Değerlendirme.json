    {
      "parameters": {
        "jsCode": "// Karar kuralları kodda: model öneri verir, kuralı insan belirler\nconst k = $('Maskele').first().json;\nconst o = $input.first().json.output;\nconst tutar = Number(o.itiraz_tutari) || 0;\nconst onay_gerekli = tutar > 100 || o.talep === 'Abonelik İptali' || o.kategori === 'Diğer';\nreturn [{ json: {\n  ...k, ...o, itiraz_tutari: tutar, onay_gerekli,\n  neden: onay_gerekli ? 'Tutar 100 TL üstü, iptal talebi veya belirsiz kategori' : '100 TL ve altı, standart kategori'\n} }];"
      },
