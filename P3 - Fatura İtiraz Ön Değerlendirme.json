              "name": "kategori",
              "type": "string",
              "description": "Şunlardan biri: Roaming, Ek Paket, Katma Değerli Servis, Cihaz Taksiti, Gecikme Bedeli, Diğer",
              "required": true
            },
            {
              "name": "itiraz_tutari",
              "type": "number",
              "description": "İtiraz edilen tutar TL olarak, sadece sayı. Belirtilmemişse 0",
              "required": true
            },
            {
              "name": "talep",
              "type": "string",
              "description": "Şunlardan biri: İade, Açıklama, Abonelik İptali",
              "required": true
