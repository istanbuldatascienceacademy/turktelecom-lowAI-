    {
      "parameters": {
        "jsCode": "function maskele(t) {\n  return String(t || '')\n    .replace(/\\b0?(5\\d{2})[\\s-]?\\d{3}[\\s-]?\\d{2}[\\s-]?(\\d{2})\\b/g, '$1*****$2') // hat no (önce)\n    .replace(/\\b[1-9]\\d{10}\\b/g, '[TCKN]')                          // TC kimlik no\n    .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '[EPOSTA]')               // e-posta\n    .replace(/\\bTR\\d{2}(?:\\s?\\d{4}){5}\\s?\\d{2}\\b/gi, '[IBAN]');      // IBAN\n}\n\nconst f = $input.first().json;\nreturn [{ json: {\n  takip_no: 'FI-' + Date.now().toString().slice(-6),\n  hat_no: maskele(f['Hat Numarası']),\n  donem: f['Fatura Dönemi'],\n  itiraz: maskele(f['İtiraz Metni'])\n} }];"
      },
      "id": "d0af5206-b9b9-4d0a-ae97-028d37cf9017",
      "name": "Maskele",
